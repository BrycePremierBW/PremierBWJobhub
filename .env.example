# Core storage and database
DATA_DIR=/var/data
# DATABASE_URL=
APP_BASE_URL=http://localhost:8501
JOBHUB_TIMEZONE=Australia/Brisbane

# One-time secure administrator bootstrap
JOBHUB_BOOTSTRAP_ADMIN_USERNAME=admin
# JOBHUB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Recovery verification
# Set this only after a PostgreSQL recovery/export has been restored to an
# isolated database and checked successfully. ISO date/time recommended.
# JOBHUB_POSTGRES_RESTORE_VERIFIED_AT=2026-08-10T03:00:00+10:00

# BrightHR Customer API / Blip attendance
# Credentials must come from BrightHR API Management. Never commit real values.
# BRIGHTHR_CLIENT_ID=
# BRIGHTHR_CLIENT_SECRET=
BRIGHTHR_TOKEN_URL=https://login.brighthr.com/connect/token
BRIGHTHR_EMPLOYEES_URL=https://api.bright.hr/employees/v1/query
BRIGHTHR_BLIP_ATTENDANCE_URL=https://api.bright.hr/blip/v1/clockings/query
# Optional only when BrightHR explicitly requires it for the API application.
# BRIGHTHR_SCOPE=
# BRIGHTHR_TOKEN_AUTH_MODE=body
# Optional import window, e.g. 2026-08-01 or a full ISO timestamp.
# BRIGHTHR_SYNC_FROM=
# BRIGHTHR_SYNC_TO=

# Optional push notifications
# ONESIGNAL_APP_ID=
# ONESIGNAL_REST_API_KEY=

# Optional email delivery
JOBHUB_EMAIL_NOTIFICATIONS_ENABLED=false
# JOBHUB_EMAIL_PROVIDER=
# JOBHUB_EMAIL_FROM=

# Optional offline synchronisation
JOBHUB_OFFLINE_SYNC_ENABLED=false

# AI is local/off by default. External AI requires explicit policy approval.
AI_PROVIDER=none
JOBHUB_ALLOW_EXTERNAL_AI=false
JOBHUB_AI_INCLUDE_PERSONAL_DATA=false
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Local Ollama alternative
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Keep production source editing disabled.
JOBHUB_ENABLE_SELF_EDIT=false

# Optional diagnostics
SHOW_STORAGE_CHECK=false
