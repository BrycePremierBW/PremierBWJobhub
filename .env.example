# Core storage and database
DATA_DIR=/var/data
# DATABASE_URL=

# One-time secure administrator bootstrap
JOBHUB_BOOTSTRAP_ADMIN_USERNAME=admin
# JOBHUB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# AI is local/off by default. External AI requires explicit policy approval.
AI_PROVIDER=none
JOBHUB_ALLOW_EXTERNAL_AI=false
JOBHUB_AI_INCLUDE_PERSONAL_DATA=false
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Local Ollama alternative
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b

# Keep production source editing disabled.
JOBHUB_ENABLE_SELF_EDIT=false

# Optional diagnostics
SHOW_STORAGE_CHECK=false
