* text=auto

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
# CSV files include supplier/job exports with significant Windows line endings.
# Preserve their imported bytes instead of making clean checkouts appear modified.
*.csv -text
*.sql text eol=lf
*.bat text eol=crlf

*.pdf binary
*.png binary
*.xlsx binary
